{
  "manifest_version": 3,
  "name": "Chinese Pinyin Copier",
  "version": "1.0.0",
  "description": "Click the pinned extension icon to copy the Pinyin of selected Chinese text directly to your clipboard.",
  "permissions": [
    "activeTab",
    "scripting",
    "clipboardWrite",
    "clipboardRead",
    "storage"
  ],
  "action": {
    "default_title": "Copy Pinyin for selected Chinese text",
    "default_icon": {
      "16": "icons/icon16.png",
      "32": "icons/icon32.png",
      "48": "icons/icon48.png",
      "128": "icons/icon128.png"
    }
  },
  "background": {
    "service_worker": "background.js"
  },
  "options_ui": {
    "page": "options.html",
    "open_in_tab": false
  },
  "icons": {
    "16": "icons/icon16.png",
    "32": "icons/icon32.png",
    "48": "icons/icon48.png",
    "128": "icons/icon128.png"
  }
}
